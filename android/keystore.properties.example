# Copy this template to a SECURE location OUTSIDE version control, for example:
#   %USERPROFILE%\.litegame-capture\signing\keystore.properties
# (Or gitignored android/keystore.properties)
# NEVER commit your real keystore file or passwords to GitHub.

storeFile=C:/Users/YOUR_USERNAME/.litegame-capture/signing/litegame-release.jks
storePassword=CHANGE_ME_STRONG_STORE_PASSWORD
keyAlias=litegame-release
keyPassword=CHANGE_ME_STRONG_KEY_PASSWORD
